# --- Serveur ---
PORT=4000
NODE_ENV=development

# PostgreSQL (développement local : `npm run dev:db` démarre un Postgres embarqué sur ce port)
DATABASE_URL=postgres://mysms:mysms@localhost:5433/mysms

# Optionnel — requis pour plusieurs instances du serveur (mode horizontal)
REDIS_URL=

# Cookies sécurisés HTTPS — à activer en production derrière un reverse proxy TLS
COOKIE_SECURE=false

# Durée de vie de la session (jours)
TOKEN_TTL_DAYS=30
